# RVA SaaS Platform - Environment Variables Template
# Copy this file to .env and fill in your local values.
# NEVER commit the actual .env file to version control.

# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL 17 Connection
DATABASE_URL=postgresql://rva_user:CHANGE_ME@localhost:5432/rva_db
DATABASE_POOL_SIZE=20

# Multi-Tenancy
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# JWT Authentication (Generate a strong 256-bit secret)
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_256_BIT_SECRET
JWT_EXPIRATION=15m

# Observability (OpenTelemetry)
OTEL_SERVICE_NAME=rva-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# AWS Secrets Manager (Production only)
AWS_REGION=us-east-1
SECRETS_MANAGER_PREFIX=/rva/staging